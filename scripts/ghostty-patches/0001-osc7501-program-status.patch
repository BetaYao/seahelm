+/// One program status report (OSC 7501), decoded for the embedder.
+///
+/// The strings live in `text`, behind a pointer, so the action union stays
+/// within its fixed size. Every string is null-terminated and valid only
+/// for the duration of the action callback; copy what you keep. An empty
+/// string means the program did not send that key. A report replaces its
+/// record completely, so an absent key means the record no longer has
+/// that value.
+///
+/// `state = .clear` removes the record named by `id` and every record
+/// beneath it; with an empty `id` it removes every record.
+pub const ProgramStatus = struct {
+    pub const State = terminal.osc.program_status.State;
+    pub const Kind = terminal.osc.program_status.Kind;
+
+    // Sync with: ghostty_action_program_status_text_s
+    pub const Text = extern struct {
+        id: [*:0]const u8 = "",
+        app: [*:0]const u8 = "",
+        title: [*:0]const u8 = "",
+        msg: [*:0]const u8 = "",
+    };
+
+    state: State,
+    kind: ?Kind = null,
+    progress: ?u8 = null,
+    text: *const Text,
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        state: c_int,
+        /// -1 when absent.
+        kind: i8,
+        /// -1 when absent or indeterminate.
+        progress: i8,
+        text: *const Text,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .state = @intFromEnum(self.state),
+            .kind = if (self.kind) |k| @intCast(@intFromEnum(k)) else -1,
+            .progress = if (self.progress) |p| @intCast(@min(p, 100)) else -1,
+            .text = self.text,
+        };
+    }
+};
+
