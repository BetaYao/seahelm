+/// Decode a validated OSC 7501 report body and hand it to the apprt.
+fn programStatus(
+    self: *Surface,
+    state: terminal.osc.program_status.State,
+    data: []const u8,
+) !void {
+    const ps = terminal.osc.program_status;
+    const report: ps.Report = .{ .state = state, .data = data };
+
+    var id_buf: [ps.max_id_bytes + 1]u8 = undefined;
+    var app_buf: [ps.max_app_bytes + 1]u8 = undefined;
+    var title_buf: [ps.max_title_bytes + 1]u8 = undefined;
+    var msg_buf: [ps.max_msg_bytes + 1]u8 = undefined;
+
+    const text: apprt.action.ProgramStatus.Text = .{
+        .id = (try copyZ(&id_buf, report.readOption(.id) orelse "")).ptr,
+        .app = (try copyZ(&app_buf, report.readOption(.app) orelse "")).ptr,
+        .title = (try decodeZ(&title_buf, report, .title)).ptr,
+        .msg = (try decodeZ(&msg_buf, report, .msg)).ptr,
+    };
+
+    _ = try self.rt_app.performAction(
+        .{ .surface = self },
+        .program_status,
+        .{
+            .state = state,
+            .kind = report.readOption(.kind),
+            .progress = report.readOption(.progress),
+            .text = &text,
+        },
+    );
+}
+
+fn copyZ(buf: []u8, s: []const u8) ![:0]const u8 {
+    if (s.len >= buf.len) return error.NoSpaceLeft;
+    @memcpy(buf[0..s.len], s);
+    buf[s.len] = 0;
+    return buf[0..s.len :0];
+}
+
+fn decodeZ(
+    buf: []u8,
+    report: terminal.osc.program_status.Report,
+    comptime option: terminal.osc.program_status.Option,
+) ![:0]const u8 {
+    var writer: std.Io.Writer = .fixed(buf[0 .. buf.len - 1]);
+    try report.writeText(option, &writer);
+    const n = writer.buffered().len;
+    buf[n] = 0;
+    return buf[0..n :0];
+}
+
 fn selectionScrollTick(self: *Surface) !void {
     // If we're no longer active then we don't do anything.
     if (!self.selection_scroll_active) return;
