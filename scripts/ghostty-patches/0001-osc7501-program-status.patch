+
+    /// A program status report or support query (OSC 7501).
+    ///
+    /// The query is always answered: this build exists for an embedder
+    /// that consumes the reports (the `program_status` apprt action), and
+    /// programs such as Claude Code only report once the query is
+    /// answered. Records are not kept here; the embedder keeps one per id
+    /// and applies the specification's lifetime rules.
+    fn programStatus(
+        self: *StreamHandler,
+        cmd: terminal.osc.Command.ProgramStatus,
+    ) !void {
+        switch (cmd) {
+            .query => |terminator| {
+                var buf: [128]u8 = undefined;
+                const resp = try std.fmt.bufPrint(
+                    &buf,
+                    "\x1b]7501;{s}{s}",
+                    .{ terminal.osc.program_status.query_reply, terminator.string() },
+                );
+                const msg = try termio.Message.writeReq(self.alloc, resp);
+                self.messageWriter(msg);
+            },
+
+            .report => |report| {
+                const data = apprt.surface.Message.WriteReq.init(
+                    self.alloc,
+                    report.data,
+                ) catch |err| {
+                    log.warn("error copying program status report err={}", .{err});
+                    return;
+                };
+                self.surfaceMessageWriter(.{ .program_status = .{
+                    .state = report.state,
+                    .data = data,
+                } });
+            },
+        }
+    }
 };
