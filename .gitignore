# Git worktrees
.worktrees/

# Installed dependencies, anywhere. Not merely untidy: a worktree card
# counts untracked files as the agent's new work (see WorktreeGitStats),
# so one stray `npm install` reported +92376 lines on a clean tree.
node_modules/

# secrets
.env
clients/seahelm-stack/.env
clients/seahelm-stack/cloudflared.yml

# Local Watch gateway API key
apple-watch/Secrets.xcconfig

# Gmail OAuth client secret downloaded from Google Cloud Console. Never
# committed — CI bakes GMAIL_OAUTH_CLIENT_ID/SECRET into release builds
# (see project.yml, scripts/package_release.sh) from repo secrets instead.
client_secret_*.json
gmail-oauth-client.json

# AI assistant configs
.cursor/
.claude/

# Python bytecode from scripts/perf
__pycache__/

# Wrangler (Cloudflare Pages CLI) local state
.wrangler/
